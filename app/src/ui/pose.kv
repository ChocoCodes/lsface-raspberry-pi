#:kivy 2.3.1
#:import dp kivy.metrics.dp
#:import tokens src.ui.tokens

<PoseScreen>:
    canvas.before:
        Color:
            rgba: tokens.COLOR_BG
        Rectangle:
            pos: self.pos
            size: self.size

    # Layer 0: Camera Feed (Full Bleed Edge-to-Edge)
    Image:
        id: camera_feed
        allow_stretch: True
        keep_ratio: False
        size_hint: (1, 1)
        pos: (0, 0)

    # Layer 1: Translucent White Overlay with Oval Cutout at the Middle
    FaceCutoutOverlay:
        id: overlay
        size_hint: (1, 1)
        pos: (0, 0)
        overlay_color: (1.0, 1.0, 1.0, 0.65)
        border_color: (1.0, 1.0, 1.0, 0.90)
        border_width: dp(2.5)

    # Layer 2: Top Navigation (Back Button Only)
    BoxLayout:
        size_hint: (1, None)
        height: dp(56)
        pos_hint: {'x': 0, 'top': 1.0}
        padding: [dp(24), dp(12), dp(24), dp(8)]

        BackButton:
            size_hint: (None, None)
            width: dp(96)
            height: dp(38)
            pos_hint: {'center_y': 0.5}
            on_release: root.go_back()

        Widget:

    # Layer 3: 3-Language Stacked Guide Text (Identical weight, color, and size across EN, JA, KO)
    BoxLayout:
        orientation: 'vertical'
        size_hint: (0.90, None)
        height: dp(84)
        pos_hint: {'center_x': 0.5, 'top': 0.97}
        spacing: dp(3)

        Label:
            text: root.instruction_en
            font_name: tokens.FONT_BLACK
            font_size: f"{tokens.FONT_SIZE_TITLE - 2}sp"
            bold: True
            color: tokens.COLOR_ACCENT if root.phase != 'error' else tokens.COLOR_ERROR
            halign: 'center'
            valign: 'middle'
            text_size: self.size

        Label:
            text: root.instruction_ja
            font_name: tokens.FONT_CJK
            font_size: f"{tokens.FONT_SIZE_TITLE - 2}sp"
            bold: True
            color: tokens.COLOR_ACCENT if root.phase != 'error' else tokens.COLOR_ERROR
            halign: 'center'
            valign: 'middle'
            text_size: self.size

        Label:
            text: root.instruction_ko
            font_name: tokens.FONT_CJK
            font_size: f"{tokens.FONT_SIZE_TITLE - 2}sp"
            bold: True
            color: tokens.COLOR_ACCENT if root.phase != 'error' else tokens.COLOR_ERROR
            halign: 'center'
            valign: 'middle'
            text_size: self.size

    # Layer 4: Live Feedback / Note Text (Positioned below the Oval Cutout)
    Label:
        text: root.note_text
        size_hint: (0.85, None)
        height: dp(22)
        pos_hint: {'center_x': 0.5, 'y': 0.12}
        font_name: tokens.FONT_MEDIUM
        font_size: f"{tokens.FONT_SIZE_BODY}sp"
        color: tokens.COLOR_TEXT_SECONDARY
        halign: 'center'
        valign: 'middle'
        text_size: self.size
        opacity: 1.0 if root.note_text else 0.0

    # Layer 5: Operator Shortcuts Guide (Setup mode only)
    Label:
        text: 'F / L / R / U / D twice: record  •  G: restart  •  Esc: cancel current  •  S: save setup' if root.mode == 'setup' else ''
        size_hint: (0.9, None)
        height: dp(24) if root.mode == 'setup' else 0
        opacity: 1.0 if root.mode == 'setup' else 0.0
        pos_hint: {'center_x': 0.5, 'y': 0.02}
        font_name: tokens.FONT_MEDIUM
        font_size: f"{tokens.FONT_SIZE_MICRO}sp"
        color: tokens.COLOR_TEXT_MUTED
        halign: 'center'
        valign: 'middle'
        text_size: self.size

    # Layer 6: Action Controls (Quiet Icon Buttons on Bottom-Left)
    BoxLayout:
        size_hint: (None, None)
        size: (self.minimum_width, dp(46))
        pos_hint: {'x': 0.035, 'y': 0.035}
        spacing: dp(10)

        QuietStartButton:
            disabled: root.phase not in ('ready', 'setup', 'error')
            opacity: 0.35 if self.disabled else 1.0
            on_release: root.primary_action()

        QuietRestartButton:
            disabled: root.phase not in ('calibrating', 'capture', 'feedback', 'error')
            opacity: 0.35 if self.disabled else 1.0
            on_release: root.restart()
