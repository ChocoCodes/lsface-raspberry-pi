#:kivy 2.3.1
#:import dp kivy.metrics.dp

<PoseStep@BoxLayout>:
    label_text: ''
    step_state: 'waiting'
    spacing: '5dp'

    Widget:
        size_hint_x: None
        width: '18dp'
        canvas:
            Color:
                rgba: (0.42, 0.91, 0.75, 1) if root.step_state in ('done', 'active') else (0.75, 0.30, 0.30, 1) if root.step_state == 'error' else (0, 0, 0, 0)
            Ellipse:
                pos: (self.x + dp(3), self.center_y - dp(6))
                size: (dp(12), dp(12))
            Color:
                rgba: (0.42, 0.91, 0.75, 1) if root.step_state == 'active' else (0.75, 0.30, 0.30, 1) if root.step_state == 'error' else (0.50, 0.56, 0.65, 1) if root.step_state == 'waiting' else (0, 0, 0, 0)
            Line:
                circle: (self.x + dp(9), self.center_y, dp(6))
                width: 1.3
            Color:
                rgba: (0.045, 0.063, 0.094, 1) if root.step_state == 'done' else (1, 1, 1, 1) if root.step_state == 'error' else (0, 0, 0, 0)
            Line:
                points: (self.x + dp(5), self.center_y, self.x + dp(8), self.center_y - dp(3), self.x + dp(13), self.center_y + dp(3)) if root.step_state == 'done' else (self.x + dp(5), self.center_y - dp(4), self.x + dp(13), self.center_y + dp(4))
                width: 1.5
            Line:
                points: (0, 0, 0, 0) if root.step_state == 'done' else (self.x + dp(5), self.center_y + dp(4), self.x + dp(13), self.center_y - dp(4))
                width: 1.5

    Label:
        text: root.label_text
        font_size: '13sp'
        bold: root.step_state == 'active'
        color: (0.93, 0.96, 0.98, 1) if root.step_state in ('done', 'active') else (1, 0.64, 0.47, 1) if root.step_state == 'error' else (0.50, 0.56, 0.65, 1)
        halign: 'left'
        valign: 'middle'
        text_size: self.size

<PoseScreen>:
    canvas.before:
        Color:
            rgba: (0.045, 0.063, 0.094, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: ['34dp', '24dp', '34dp', '26dp']
        spacing: '14dp'

        BoxLayout:
            size_hint_y: None
            height: '42dp'
            spacing: '12dp'

            Button:
                text: '‹  Back'
                size_hint_x: None
                width: '100dp'
                background_normal: ''
                background_color: (0.12, 0.16, 0.23, 1)
                color: (0.93, 0.96, 0.98, 1)
                on_release: root.go_back()

            Label:
                text: 'ADD IDENTITY' if root.mode == 'scan' else 'DEVICE SETUP'
                font_size: '17sp'
                bold: True
                color: (0.93, 0.96, 0.98, 1)
                halign: 'left'
                text_size: self.size

            Label:
                text: 'PNP READY' if root.phase not in ('setup', 'error') else 'SETUP REQUIRED'
                size_hint_x: None
                width: '145dp'
                font_size: '12sp'
                color: (0.42, 0.91, 0.75, 1) if root.phase not in ('setup', 'error') else (1, 0.72, 0.34, 1)
                halign: 'right'
                valign: 'middle'
                text_size: self.size

        BoxLayout:
            orientation: 'vertical'
            padding: ['16dp', '16dp', '16dp', '16dp']
            spacing: '8dp'
            canvas.before:
                Color:
                    rgba: (0.09, 0.12, 0.17, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [18,]

            Image:
                id: camera_feed
                allow_stretch: True
                keep_ratio: True

        Label:
            text: root.instruction_text
            size_hint_y: None
            height: '38dp'
            font_size: '25sp'
            bold: True
            color: (0.42, 0.91, 0.75, 1) if root.phase != 'error' else (1, 0.64, 0.47, 1)
            halign: 'center'
            valign: 'middle'
            text_size: self.size

        Label:
            text: root.note_text
            size_hint_y: None
            height: '26dp'
            font_size: '14sp'
            color: (0.67, 0.72, 0.80, 1)
            halign: 'center'
            valign: 'middle'
            text_size: self.size

        Label:
            text: 'F / L / R / U / D twice: record   •   G: restart   •   Esc: cancel current   •   S: save completed setup' if root.mode == 'setup' else ''
            size_hint_y: None
            height: '20dp' if root.mode == 'setup' else '0dp'
            font_size: '11sp'
            color: (0.50, 0.56, 0.65, 1)
            halign: 'center'
            valign: 'middle'
            text_size: self.size

        ProgressBar:
            max: 1
            value: root.progress_value
            size_hint_y: None
            height: '10dp'

        BoxLayout:
            size_hint_y: None
            height: '26dp'
            spacing: '12dp'

            PoseStep:
                label_text: 'FRONT'
                step_state: root.step_states[0]

            PoseStep:
                label_text: 'LEFT'
                step_state: root.step_states[1]

            PoseStep:
                label_text: 'RIGHT'
                step_state: root.step_states[2]

            PoseStep:
                label_text: 'UP'
                step_state: root.step_states[3]

            PoseStep:
                label_text: 'DOWN'
                step_state: root.step_states[4]

        BoxLayout:
            size_hint_y: None
            height: '48dp'
            spacing: '12dp'

            Button:
                text: 'Restart'
                size_hint_x: None
                width: '120dp'
                background_normal: ''
                background_color: (0.12, 0.16, 0.23, 1)
                color: (0.93, 0.96, 0.98, 1)
                disabled: root.phase in ('loading', 'setup', 'complete', 'error')
                on_release: root.restart()

            Widget:

            Button:
                text: root.action_text
                size_hint_x: None
                width: '210dp'
                background_normal: ''
                background_color: (0.17, 0.70, 0.54, 1) if root.action_text else (0.12, 0.16, 0.23, 1)
                color: (0.03, 0.08, 0.07, 1) if root.action_text else (0.45, 0.50, 0.58, 1)
                disabled: not root.action_text
                on_release: root.primary_action()
