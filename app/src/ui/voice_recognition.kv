#:kivy 2.3.1
#:import dp kivy.metrics.dp

<VoiceRecognitionScreen>:
    canvas.before:
        Color:
            rgba: (0.045, 0.063, 0.094, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: ['34dp', '24dp', '34dp', '26dp']
        spacing: '16dp'

        BoxLayout:
            size_hint_y: None
            height: '42dp'
            spacing: '12dp'

            Button:
                text: '‹  Back'
                size_hint_x: None
                width: '100dp'
                background_normal: ''
                background_color: (0.12, 0.16, 0.23, 1)
                color: (0.93, 0.96, 0.98, 1)
                disabled: root.state == 'committing'
                on_release: root.go_back()

            Label:
                text: 'NAME ENROLLMENT'
                font_size: '17sp'
                bold: True
                color: (0.93, 0.96, 0.98, 1)
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            Label:
                text: root.database_id if root.database_id else 'NO DATABASE'
                size_hint_x: None
                width: '180dp'
                font_size: '11sp'
                color: (0.50, 0.56, 0.65, 1)
                halign: 'right'
                valign: 'middle'
                text_size: self.size

        Widget:
            size_hint_y: None
            height: '2dp'

        Label:
            text: root.prompt_text
            size_hint_y: None
            height: '52dp'
            font_size: '30sp'
            bold: True
            color: (0.42, 0.91, 0.75, 1)
            halign: 'center'
            valign: 'middle'
            text_size: self.size

        Label:
            text: root.status_text
            size_hint_y: None
            height: '28dp'
            font_size: '15sp'
            color: (0.93, 0.96, 0.98, 1)
            halign: 'center'
            valign: 'middle'
            text_size: self.size

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: '300dp'
            spacing: '26dp'
            padding: ['26dp', '24dp', '26dp', '24dp']
            canvas.before:
                Color:
                    rgba: (0.09, 0.12, 0.17, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [18,]

            Widget:
                size_hint_x: None
                width: '190dp'
                canvas:
                    Color:
                        rgba: (0.42, 0.91, 0.75, 0.16 + root.audio_level * 0.34)
                    Line:
                        circle: (self.center_x, self.center_y, dp(78))
                        width: 3.0
                    Color:
                        rgba: (0.14, 0.22, 0.27, 1)
                    RoundedRectangle:
                        pos: (self.center_x - dp(25), self.center_y - dp(55))
                        size: (dp(50), dp(94))
                        radius: [dp(25),]
                    Color:
                        rgba: (0.42, 0.91, 0.75, 1)
                    RoundedRectangle:
                        pos: (self.center_x - dp(16), self.center_y - dp(45))
                        size: (dp(32), dp(72))
                        radius: [dp(16),]
                    Line:
                        points: (self.center_x - dp(54), self.center_y - dp(2), self.center_x - dp(54), self.center_y - dp(2), self.center_x, self.center_y - dp(70), self.center_x + dp(54), self.center_y - dp(2), self.center_x + dp(54), self.center_y - dp(2))
                        width: 4.0
                    Line:
                        points: (self.center_x, self.center_y - dp(70), self.center_x, self.center_y - dp(91))
                        width: 4.0
                    Line:
                        points: (self.center_x - dp(22), self.center_y - dp(91), self.center_x + dp(22), self.center_y - dp(91))
                        width: 4.0

            BoxLayout:
                orientation: 'vertical'
                spacing: '10dp'

                Label:
                    text: 'Name / transcript'
                    size_hint_y: None
                    height: '28dp'
                    font_size: '13sp'
                    color: (0.67, 0.72, 0.80, 1)
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size

                TextInput:
                    id: name_input
                    text: root.transcript
                    multiline: False
                    hint_text: 'Type the person\'s name'
                    disabled: root.name_locked or root.state == 'complete'
                    size_hint_y: None
                    height: '50dp'
                    padding: ['14dp', '12dp']
                    background_color: (0.14, 0.18, 0.25, 1)
                    foreground_color: (0.93, 0.96, 0.98, 1)
                    cursor_color: (0.42, 0.91, 0.75, 1)
                    on_text: root.set_transcript_from_input(self.text)
                    on_text_validate: root.continue_enrollment()

                Label:
                    text: root.audio_status
                    size_hint_y: None
                    height: '34dp'
                    font_size: '12sp'
                    color: (0.67, 0.72, 0.80, 1)
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size

                Label:
                    text: 'Optional microphone level'
                    size_hint_y: None
                    height: '18dp'
                    font_size: '11sp'
                    color: (0.50, 0.56, 0.65, 1)
                    halign: 'left'
                    text_size: self.size

                ProgressBar:
                    max: 1
                    value: root.audio_level
                    size_hint_y: None
                    height: '8dp'

                Label:
                    text: root.progress_text
                    size_hint_y: None
                    height: '28dp'
                    font_size: '13sp'
                    color: (0.42, 0.91, 0.75, 1) if root.state != 'error' else (1, 0.64, 0.47, 1)
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size

                ProgressBar:
                    max: 1
                    value: root.enrollment_progress
                    size_hint_y: None
                    height: '9dp'

        Widget:

        BoxLayout:
            size_hint_y: None
            height: '48dp'
            spacing: '12dp'

            Label:
                text: 'Press Enter after confirming the displayed name.'
                font_size: '12sp'
                color: (0.50, 0.56, 0.65, 1)
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            Button:
                text: root.action_text
                size_hint_x: None
                width: '220dp'
                background_normal: ''
                background_color: (0.17, 0.70, 0.54, 1) if root.continue_enabled else (0.12, 0.16, 0.23, 1)
                color: (0.03, 0.08, 0.07, 1) if root.continue_enabled else (0.45, 0.50, 0.58, 1)
                disabled: not root.continue_enabled
                on_release: root.continue_enrollment()
