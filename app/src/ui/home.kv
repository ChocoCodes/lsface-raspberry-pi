#:kivy 2.3.1
#:import ICONS_PATH src.config.config.ICONS_PATH

<ActionCard@ButtonBehavior+BoxLayout>:
    orientation: 'vertical'
    padding: [10, 25, 10, 20]
    spacing: '15dp'
    card_title: ''
    icon_source: ''

    canvas.before:
        Color:
            rgba: (0.94, 0.94, 0.94, 1) if self.state == 'down' else (1, 1, 1, 1)
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: (0.2, 0.2, 0.2, 1)
        Line:
            width: 1.2
            rectangle: (self.x, self.y, self.width, self.height)

    Image:
        source: root.icon_source
        mipmap: True
        size_hint_y: 0.65
        allow_stretch: True
        keep_ratio: True

    Label:
        text: root.card_title
        size_hint_y: 0.4
        font_size: '18sp'
        color: (0.1, 0.1, 0.1, 1)
        halign: 'center'
        valign: 'middle'

<HomeScreenView>:
    orientation: 'vertical'
    padding: ['40dp', '60dp', '40dp', '60dp']
    spacing: '25dp'

    # App Header
    Label:
        text: 'Face Recognition System using LS-Face'
        font_size: '22sp'
        bold: True
        color: (0.1, 0.1, 0.1, 1)
        size_hint_y: None
        height: '40dp'

    # Controls Section (Camera & DB Selection)
    BoxLayout:
        orientation: 'vertical'
        size_hint: (None, None)
        size: ('320dp', '150dp')
        pos_hint: {'center_x': 0.5}
        spacing: '8dp'

        Label:
            text: 'Camera'
            font_size: '14sp'
            color: (0.2, 0.2, 0.2, 1)
            size_hint: (1, None)
            height: 18
            text_size: self.size
            halign: 'left'

        Spinner:
            id: camera_selector
            text: 'Default PC Camera'
            values: ['Default PC Camera', 'Raspberry Pi Camera']
            size_hint: (1, None)
            height: 38
            background_normal: ''
            background_color: (0.85, 0.85, 0.85, 1)
            color: (0.1, 0.1, 0.1, 1)
            on_text: root.on_camera_changed(self.text)

        Label:
            text: 'Database'
            font_size: '14sp'
            color: (0.2, 0.2, 0.2, 1)
            size_hint: (1, None)
            height: 18
            text_size: self.size
            halign: 'left'

        Spinner:
            id: db_selector
            text: 'La Salle Database'
            values: ['La Salle Database', 'Demo Database']
            size_hint: (1, None)
            height: 38
            background_normal: ''
            background_color: (0.85, 0.85, 0.85, 1)
            color: (0.1, 0.1, 0.1, 1)
            on_text: root.on_database_changed(self.text)

    # Spacer
    Widget:
        size_hint_y: None
        height: 20

    # 3 Main Actions Row
    BoxLayout:
        orientation: 'horizontal'
        size_hint: (None, None)
        size: ('660dp', '200dp')
        pos_hint: {'center_x': 0.5}
        spacing: '25dp'

        ActionCard:
            card_title: 'Add Identity'
            icon_source: f"{ICONS_PATH}/user-plus.png"
            on_release: root.open_add_identity()

        ActionCard:
            card_title: 'Recognition'
            icon_source: f"{ICONS_PATH}/scan-text.png"
            on_release: root.open_recognition()

        ActionCard:
            card_title: 'View Identities'
            icon_source: f"{ICONS_PATH}/user-round-pen.png"
            on_release: root.open_view_identities()

    Widget:
        size_hint_y: 1