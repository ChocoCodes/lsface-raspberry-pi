#:kivy 2.3.1
#:import dp kivy.metrics.dp
#:import ICONS_PATH src.config.config.ICONS_PATH
#:import CAMERA_NAMES src.config.config.CAMERA_NAMES
#:import tokens src.ui.tokens

<HomeScreenView>:
    # =========================================================================
    # ROOT BACKGROUND
    # =========================================================================
    canvas.before:
        Color:
            rgba: tokens.COLOR_BG
        Rectangle:
            pos: self.pos
            size: self.size

    # =========================================================================
    # MAIN PAGE CONTENT
    # =========================================================================
    BoxLayout:
        orientation: 'vertical'
        size_hint: (1, 1)
        padding: [dp(48), dp(36), dp(48), dp(32)]
        spacing: dp(24)

        # Header Bar (Clean branding on left, hamburger menu on right)
        BoxLayout:
            size_hint_y: None
            height: dp(68)
            spacing: dp(20)

            # Branding (Titles)
            BoxLayout:
                orientation: 'vertical'
                spacing: dp(4)

                Label:
                    text: 'Smart Gate'
                    size_hint_y: None
                    height: dp(38)
                    font_name: tokens.FONT_BLACK
                    font_size: f"{tokens.FONT_SIZE_HERO - 2}sp"
                    color: tokens.COLOR_ACCENT
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size

                Label:
                    text: 'An Edge-Based Facial Recognition System Using LS-Face'
                    size_hint_y: None
                    height: dp(26)
                    font_name: tokens.FONT_BOLD
                    font_size: f"{tokens.FONT_SIZE_BODY + 1}sp"
                    bold: True
                    color: tokens.COLOR_TEXT_SECONDARY
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size

            Widget:

            # Top-Right Controls: Frameless Hamburger Button
            BoxLayout:
                size_hint: (None, None)
                width: dp(44)
                height: dp(44)
                pos_hint: {'center_y': 0.5}

                HamburgerButton:
                    pos_hint: {'center_y': 0.5}
                    on_release: root.toggle_sidebar()

        # Spacer
        Widget:
            size_hint_y: None
            height: dp(8)

        # Three Navigation Action Cards
        BoxLayout:
            size_hint_y: 1
            spacing: dp(24)

            AppActionCard:
                inverted: True
                card_title: 'Register'
                card_body: 'Register your face and try the system.\n[color=#C8E6C9][i]No photos stored[/i][/color]'
                icon_source: f"{ICONS_PATH}/user-plus.png"
                on_release: root.open_add_identity()

            AppActionCard:
                card_title: 'Check live access'
                card_body: 'Walk up to the camera to see instant match results.'
                icon_source: f"{ICONS_PATH}/scan-text.png"
                on_release: root.open_recognition()

            AppActionCard:
                card_title: 'View Database'
                card_body: 'Check everyone who has already registered today.'
                icon_source: f"{ICONS_PATH}/user-round-pen.png"
                on_release: root.open_view_identities()

    # =========================================================================
    # SIDEBAR BACKDROP (Dimming click-to-dismiss overlay)
    # =========================================================================
    SidebarBackdrop:
        id: sidebar_backdrop
        size_hint: (1, 1) if root.sidebar_open else (None, None)
        size: root.size if root.sidebar_open else (0, 0)
        pos: (0, 0) if root.sidebar_open else (-10000, -10000)

    # =========================================================================
    # SLIDE-OUT RIGHT SIDEBAR DRAWER (Settings & Hardware)
    # =========================================================================
    BoxLayout:
        id: sidebar
        orientation: 'vertical'
        size_hint: (None, 1)
        width: dp(360)
        x: root.width
        padding: [dp(28), dp(28), dp(28), dp(24)]
        spacing: dp(20)
        canvas.before:
            Color:
                rgba: tokens.COLOR_SURFACE_1
            Rectangle:
                pos: self.pos
                size: self.size
        canvas.after:
            Color:
                rgba: tokens.COLOR_BORDER
            Line:
                points: (self.x, self.y, self.x, self.top)
                width: 1.5

        # Drawer Header
        BoxLayout:
            size_hint_y: None
            height: dp(36)
            spacing: dp(12)

            Label:
                text: 'SYSTEM SETTINGS'
                font_name: tokens.FONT_BLACK
                font_size: f"{tokens.FONT_SIZE_SUBTITLE}sp"
                color: tokens.COLOR_TEXT_PRIMARY
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            CloseIconButton:
                pos_hint: {'center_y': 0.5}
                on_release: root.close_sidebar()

        # Divider
        Widget:
            size_hint_y: None
            height: dp(1)
            canvas:
                Color:
                    rgba: tokens.COLOR_BORDER_MUTED
                Rectangle:
                    pos: self.pos
                    size: self.size

        # Camera Selector Section
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(82)
            spacing: dp(6)

            Label:
                text: 'CAMERA DEVICE'
                size_hint_y: None
                height: dp(16)
                font_name: tokens.FONT_BOLD
                font_size: f"{tokens.FONT_SIZE_MICRO}sp"
                bold: True
                color: tokens.COLOR_TEXT_MUTED
                halign: 'left'
                text_size: self.size

            AppSpinner:
                id: camera_selector
                text: 'Default PC Camera'
                values: CAMERA_NAMES
                on_text: root.on_camera_changed(self.text)

            Label:
                text: 'Select video capture device for recognition'
                size_hint_y: None
                height: dp(16)
                font_name: tokens.FONT_REGULAR
                font_size: f"{tokens.FONT_SIZE_CAPTION - 1}sp"
                color: tokens.COLOR_TEXT_SECONDARY
                halign: 'left'
                text_size: self.size

        # Database Selector Section
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(82)
            spacing: dp(6)

            Label:
                text: 'IDENTITY DATABASE'
                size_hint_y: None
                height: dp(16)
                font_name: tokens.FONT_BOLD
                font_size: f"{tokens.FONT_SIZE_MICRO}sp"
                bold: True
                color: tokens.COLOR_TEXT_MUTED
                halign: 'left'
                text_size: self.size

            AppSpinner:
                id: db_selector
                text: 'La Salle Database'
                values: root.database_names
                size_hint_x: 1
                on_text: root.on_database_changed(self.text)

            Label:
                text: 'Active biometric template repository'
                size_hint_y: None
                height: dp(16)
                font_name: tokens.FONT_REGULAR
                font_size: f"{tokens.FONT_SIZE_CAPTION - 1}sp"
                color: tokens.COLOR_TEXT_SECONDARY
                halign: 'left'
                text_size: self.size

        # Vertical Fill Spacer
        Widget:

        # Drawer Footer
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(40)
            spacing: dp(2)

            Label:
                text: 'LS-Face Edge v2.1 • USLS CV'
                font_name: tokens.FONT_BOLD
                font_size: f"{tokens.FONT_SIZE_CAPTION}sp"
                color: tokens.COLOR_ACCENT
                halign: 'left'
                text_size: self.size

            Label:
                text: 'Raspberry Pi 5 + Pi Camera compatible'
                font_name: tokens.FONT_REGULAR
                font_size: f"{tokens.FONT_SIZE_MICRO}sp"
                color: tokens.COLOR_TEXT_MUTED
                halign: 'left'
                text_size: self.size
