<ManageIdentitiesView>:

    orientation: "vertical"
    padding: "40dp"
    spacing: "15dp"

    canvas.before:
        Color:
            rgba: (0.97, 0.97, 0.97, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        size_hint_y: None
        height: "50dp"

        Button:
            text: '< Back'
            size_hint_x: None
            width: '110dp'
            background_normal: ''
            background_color: (0.85, 0.85, 0.85, 1)
            color: (0.1, 0.1, 0.1, 1)
            on_release: root.go_back()

        Widget:
            size_hint_x: 1

        Label:
            text: "Manage Identities"
            size_hint_x: None
            width: "220dp"
            font_size: "24sp"
            bold: True
            color: (0, 0, 0, 1)
            halign: "center"
            valign: "middle"
            text_size: self.size

        Widget:
            size_hint_x: 1

        Label:
            id: identity_count
            text: "0 identities"
            size_hint_x: None
            width: "150dp"
            color: (0.3, 0.3, 0.3, 1)
            halign: "right"
            valign: "middle"
            text_size: self.size

    ScrollView:
        do_scroll_x: False
        bar_width: "8dp"

        GridLayout:
            id: identity_table

            cols: 4
            size_hint_y: None
            height: self.minimum_height

            # ID Header
            Label:
                text: "ID"
                size_hint_y: None
                height: "45dp"
                bold: True
                color: (0, 0, 0, 1)

            Label:
                text: "Name"
                size_hint_y: None
                height: "45dp"
                bold: True
                color: (0, 0, 0, 1)

            Label:
                text: "LBPH"
                size_hint_y: None
                height: "45dp"
                bold: True
                color: (0, 0, 0, 1)

            Label:
                text: "SFace"
                size_hint_y: None
                height: "45dp"
                bold: True
                color: (0, 0, 0, 1)