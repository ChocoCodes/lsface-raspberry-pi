#:kivy 2.3.1

<RecognitionScreen>:
    FloatLayout:
        BoxLayout:
            size_hint: 1, 1
            orientation: 'vertical'
            padding: ['34dp', '24dp', '34dp', '26dp']
            spacing: '14dp'
            canvas.before:
                Color:
                    rgba: (0.045, 0.063, 0.094, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size

            BoxLayout:
                size_hint_y: None
                height: '42dp'
                spacing: '12dp'

                Button:
                    text: '‹  Back'
                    size_hint_x: None
                    width: '100dp'
                    background_normal: ''
                    background_color: (0.12, 0.16, 0.23, 1)
                    color: (0.93, 0.96, 0.98, 1)
                    on_release: root.go_back()

                Label:
                    text: 'LIVE RECOGNITION'
                    font_size: '17sp'
                    bold: True
                    color: (0.93, 0.96, 0.98, 1)
                    halign: 'left'
                    text_size: self.size

                Label:
                    text: 'LIVE'
                    size_hint_x: None
                    width: '76dp'
                    color: (0.42, 0.91, 0.75, 1)
                    bold: True
                    halign: 'right'
                    text_size: self.size

            BoxLayout:
                padding: ['16dp', '16dp', '16dp', '16dp']
                canvas.before:
                    Color:
                        rgba: (0.09, 0.12, 0.17, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [18,]

                Image:
                    id: camera_feed
                    allow_stretch: True
                    keep_ratio: True

            Label:
                text: root.status_text
                size_hint_y: None
                height: '28dp'
                font_size: '13sp'
                color: (0.66, 0.72, 0.80, 1)
                halign: 'center'
                valign: 'middle'
                text_size: self.size

        FloatLayout:
            id: greeting_overlay
            size_hint: 1, 1
            opacity: root.greeting_opacity
            disabled: not root.greeting_visible
            canvas.before:
                Color:
                    rgba: (0, 0, 0, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size

            Label:
                text: root.greeting_text
                size_hint: 0.9, 0.2
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                color: (1, 1, 1, 1)
                font_size: '44sp'
                bold: True
                halign: 'center'
                valign: 'middle'
                text_size: self.size
