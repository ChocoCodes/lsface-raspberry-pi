#:kivy 2.3.1
#:import dp kivy.metrics.dp
#:import tokens src.ui.tokens

<RecognitionScreen>:
    canvas.before:
        Color:
            rgba: tokens.COLOR_BG
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        size_hint: (1, 1)
        orientation: 'vertical'
        padding: [dp(32), dp(24), dp(32), dp(24)]
        spacing: dp(16)

        # Top Navigation & Header Bar
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(16)

            BackButton:
                pos_hint: {'center_y': 0.5}
                on_release: root.go_back()

            BoxLayout:
                orientation: 'vertical'
                spacing: dp(2)
                pos_hint: {'center_y': 0.5}

                Label:
                    text: 'LIVE RECOGNITION'
                    font_name: tokens.FONT_BLACK
                    font_size: f"{tokens.FONT_SIZE_TITLE}sp"
                    color: tokens.COLOR_TEXT_PRIMARY
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size

                Label:
                    text: 'Real-time multi-angle verification • Tan-Triggs LBPH + SFace'
                    font_name: tokens.FONT_REGULAR
                    font_size: f"{tokens.FONT_SIZE_CAPTION}sp"
                    color: tokens.COLOR_TEXT_SECONDARY
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size

            Widget:

        # Video Camera Viewport (Expanded full view)
        VideoViewport:
            size_hint: (1, 1)

            Image:
                id: camera_feed
                allow_stretch: True
                keep_ratio: True
